+        ("自动", "自動"),
+        ("开始", "開始"),
+        ("文件", "檔案"),
+        ("打开", "開啟"),
+        ("保存", "儲存"),
+        ("关闭", "關閉"),
+        ("撤销", "復原"),
+        ("简体", "簡體"),
+        ("帮助", "幫助"),
+        ("无", "無"),
+        ("顶部", "頂部"),
+        ("右侧", "右側"),
+        ("左侧", "左側"),
+        ("轴", "軸"),
+        ("图", "圖"),
+        ("标", "標"),
+        ("题", "題"),
+        ("数", "數"),
+        ("据", "據"),
+        ("签", "籤"),
+        ("线", "線"),
+        ("规", "規"),
+        ("显", "顯"),
+        ("动", "動"),
+    ] {
+        value = value.replace(simplified, traditional);
+    }
+    value
+}
+
+/// Translate an owned string when a direct egui widget needs an owned label.
+pub fn owned(s: String) -> String {
+    match language() {
+        Language::En => s,
+        Language::ZhHant => to_traditional(&owned_zh_hans(s)),
+        Language::Ja => match s.as_str() {
+            "Show" => "表示".into(),
+            "Hide" => "非表示".into(),
+            "Reopen" => "再開".into(),
+            "Resolve" => "解決".into(),
+            "Move Up" => "上へ移動".into(),
+            "Move Down" => "下へ移動".into(),
+            "Remove" => "削除".into(),
+            "Go to" => "移動".into(),
+            "Don't Save" => "保存しない".into(),
+            "Create PDF Document" => "PDF ドキュメントを作成".into(),
+            "Create Handouts" => "配布資料を作成".into(),
+            "Change File Type" => "ファイルの種類を変更".into(),
+            _ => s,
+        },
+        Language::ZhHans => owned_zh_hans(s),
+    }
+}
+
+fn owned_zh_hans(s: String) -> String {
+    match s.as_str() {
+        "Show" => "显示".into(),
+        "Hide" => "隐藏".into(),
+        "Reopen" => "重新打开".into(),
+        "Resolve" => "解决".into(),
+        "Move Up" => "上移".into(),
+        "Move Down" => "下移".into(),
+        "Remove" => "移除".into(),
+        "Go to" => "转到".into(),
+        "Don't Save" => "不保存".into(),
+        "Create PDF Document" => "创建 PDF 文档".into(),
+        "Create Handouts" => "创建讲义".into(),
+        "Change File Type" => "更改文件类型".into(),
+        _ => s,
+    }
+}
