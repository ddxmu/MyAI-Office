+fn tr_zh_hant(s: &str) -> &str {
+    let source = tr_zh_hans(s);
+    if source == s {
+        return s;
+    }
+    let cache = TRADITIONAL_CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+    if let Ok(values) = cache.lock()
+        && let Some(value) = values.get(s)
+    {
+        return *value;
+    }
+    let value = Box::leak(to_traditional(source).into_boxed_str());
+    if let Ok(mut values) = cache.lock() {
+        values.insert(s.to_owned(), value);
+    }
+    value
+}
