diff --git a/crates/ui-egui/src/locale.rs b/crates/ui-egui/src/locale.rs
new file mode 100644
index 0000000..7ece3ad
--- /dev/null
+++ b/crates/ui-egui/src/locale.rs
@@ -0,0 +1,752 @@
+//! Small, deliberately localised display-text layer for the bundled MyAI Office editor.
+//!
+//! Command ids, file formats and the engine's persisted values remain in English.  Only text
+//! that is presented to a user is translated, and the MyAI Office host selects the language from
+//! the operating system without changing DeckCraft's command ids or persisted document values.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU8, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Language {
+    En = 0,
+    ZhHans = 1,
+    ZhHant = 2,
+    Ja = 3,
+}
+
+static LANGUAGE: AtomicU8 = AtomicU8::new(Language::En as u8);
+static TRADITIONAL_CACHE: OnceLock<Mutex<HashMap<String, &'static str>>> = OnceLock::new();
+
+fn language() -> Language {
+    match LANGUAGE.load(Ordering::Relaxed) {
+        1 => Language::ZhHans,
+        2 => Language::ZhHant,
+        3 => Language::Ja,
+        _ => Language::En,
+    }
+}
+
+fn from_tag(tag: &str) -> Option<Language> {
+    let base = tag.trim().split(['.', '@']).next()?;
+    let parts: Vec<String> = base.split(['-', '_']).filter(|part| !part.is_empty()).map(str::to_ascii_lowercase).collect();
+    let primary = parts.first()?.as_str();
+    match primary {
+        "en" => Some(Language::En),
+        "zh" if parts.iter().any(|part| matches!(part.as_str(), "hant" | "tw" | "hk" | "mo")) => Some(Language::ZhHant),
+        "zh" => Some(Language::ZhHans),
+        "ja" => Some(Language::Ja),
+        _ => None,
+    }
+}
+
+fn set_language(language: Language) {
+    LANGUAGE.store(language as u8, Ordering::Relaxed);
+}
+
+/// Select the interface language from the MyAI Office override or the operating system.
+pub fn configure() {
+    let explicit = std::env::var("MYAI_OFFICE_LANGUAGE").ok().filter(|value| !value.eq_ignore_ascii_case("auto")).and_then(|value| from_tag(&value));
+    let detected = explicit
+        .or_else(|| {
+            #[cfg(not(target_arch = "wasm32"))]
+            {
+                sys_locale::get_locale().and_then(|tag| from_tag(&tag))
+            }
+            #[cfg(target_arch = "wasm32")]
+            {
+                None
+            }
+        })
+        .unwrap_or(Language::En);
+    set_language(detected);
+    if enabled() {
+        load_cjk_fonts();
+    }
+}
+
+/// Enable the Simplified Chinese interface for callers that explicitly request it.
+pub fn enable_chinese() {
+    set_language(Language::ZhHans);
+    load_cjk_fonts();
+}
+
+fn load_cjk_fonts() {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let db = deckcraft_fonts::FontDb::global();
+        db.load_system_fonts();
+        #[cfg(target_os = "macos")]
+        for path in [
+            "/System/Library/Fonts/Hiragino Sans GB.ttc",
+            "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
+            "/System/Library/Fonts/STHeiti Medium.ttc",
+            "/System/Library/Fonts/Supplemental/Songti.ttc",
+        ] {
+            if let Ok(bytes) = std::fs::read(path) {
+                if db.add_font(bytes) > 0 {
+                    break;
+                }
+            }
+        }
+    }
+}
+
+pub fn enabled() -> bool {
+    language() != Language::En
+}
+
+/// Translate a user-visible label while preserving the caller's borrowed-string API.
+pub fn tr(s: &str) -> &str {
+    match language() {
+        Language::En => s,
+        Language::ZhHans => tr_zh_hans(s),
+        Language::ZhHant => tr_zh_hant(s),
+        Language::Ja => tr_ja(s),
+    }
+}
+
