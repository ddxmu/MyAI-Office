+#[cfg(test)]
+mod tests {
+    use super::{Language, from_tag, tr_ja, tr_zh_hans, tr_zh_hant};
+
+    #[test]
+    fn system_tags_distinguish_chinese_scripts() {
+        assert_eq!(from_tag("en-US"), Some(Language::En));
+        assert_eq!(from_tag("zh-CN"), Some(Language::ZhHans));
+        assert_eq!(from_tag("zh-Hant-TW"), Some(Language::ZhHant));
+        assert_eq!(from_tag("ja-JP"), Some(Language::Ja));
+    }
+
+    #[test]
+    fn reference_labels_are_localized_in_all_supported_myai_languages() {
+        assert_eq!(tr_zh_hans("Use Timings"), "使用计时");
+        assert_eq!(tr_zh_hant("Use Timings"), "使用計時");
+        assert_eq!(tr_ja("Use Timings"), "タイミングを使用");
+        assert_eq!(tr_zh_hans("Title and Content"), "标题和内容");
+        assert_eq!(tr_zh_hant("Title and Content"), "標題和內容");
+        assert_eq!(tr_ja("Title and Content"), "タイトルとコンテンツ");
+    }
+}
