+    let mut fat = vec![FREE; fat_n * 128];
+    for f in fat.iter_mut().take(fat_n) {
+        *f = 0xFFFF_FFFD;
+    }
+    fat[usize::try_from(sec(0)?).map_err(|_| "compound FAT index overflow")?] = END;
+    if let Some(m) = minifat_at {
+        fat[usize::try_from(sec(m)?).map_err(|_| "compound mini FAT index overflow")?] = END;
+    }
+    for (first, count) in chains {
+        for k in 0..count {
+            let at = usize::try_from(sec(first + k)?).map_err(|_| "compound FAT index overflow")?;
+            fat[at] = if k + 1 == count { END } else { sec(first + k + 1)? };
+        }
+    }
+    let mut out = vec![0u8; 512];
+    out[..8].copy_from_slice(&SIGNATURE);
+    out[24..26].copy_from_slice(&0x3Eu16.to_le_bytes());
+    out[26..28].copy_from_slice(&3u16.to_le_bytes());
+    out[28..30].copy_from_slice(&0xFFFEu16.to_le_bytes());
+    out[30..32].copy_from_slice(&9u16.to_le_bytes());
+    out[32..34].copy_from_slice(&6u16.to_le_bytes());
+    put32(&mut out, 44, u32::try_from(fat_n).map_err(|_| "compound FAT is too large")?);
+    put32(&mut out, 48, sec(0)?);
+    put32(&mut out, 56, 4096);
+    let minifat_start = match minifat_at {
+        Some(m) => sec(m)?,
+        None => END,
+    };
+    put32(&mut out, 60, minifat_start);
+    put32(&mut out, 64, u32::from(minifat_at.is_some()));
+    put32(&mut out, 68, END);
+    for i in 0..109 {
+        put32(&mut out, 76 + i * 4, if i < fat_n { u32::try_from(i).map_err(|_| "compound DIFAT index overflow")? } else { FREE });
+    }
+    for f in &fat {
+        out.extend_from_slice(&f.to_le_bytes());
+    }
+    for mut p in payload {
+        p.resize(512, 0);
+        out.extend_from_slice(&p);
+    }
+    if out.len() != 512usize.saturating_mul(1 + total) {
+        return Err("compound file sector layout is inconsistent".into());
+    }
+    Ok(out)
+}
+
+fn put32(b: &mut [u8], at: usize, value: u32) {
+    if let Some(dst) = b.get_mut(at..at.saturating_add(4)) {
+        dst.copy_from_slice(&value.to_le_bytes());
+    }
+}
+
+fn dir_entry(name: &str, kind: u8, child: u32, start: u32, size: u32) -> Result<[u8; 128], String> {
+    const FREE: u32 = 0xFFFF_FFFF;
+    let mut e = [0u8; 128];
+    let units: Vec<u16> = name.encode_utf16().collect();
+    for (i, u) in units.iter().enumerate() {
+        let at = i * 2;
+        e[at..at + 2].copy_from_slice(&u.to_le_bytes());
+    }
+    if !name.is_empty() {
+        let name_bytes = u16::try_from((units.len() + 1) * 2).map_err(|_| "compound directory name is too long".to_string())?;
+        e[64..66].copy_from_slice(&name_bytes.to_le_bytes());
+    }
+    e[66] = kind;
+    e[67] = 1;
+    e[68..72].copy_from_slice(&FREE.to_le_bytes());
+    e[72..76].copy_from_slice(&FREE.to_le_bytes());
+    e[76..80].copy_from_slice(&child.to_le_bytes());
+    e[116..120].copy_from_slice(&start.to_le_bytes());
+    e[120..124].copy_from_slice(&size.to_le_bytes());
+    Ok(e)
+}
