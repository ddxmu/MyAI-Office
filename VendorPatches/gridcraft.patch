+        assert_eq!(style("B2").borders.bottom.color, Color::Rgb(0x123456));
+        assert_eq!(style("B14").font.color, Color::Rgb(0xFF0000));
+    };
+    check(&wb);
+    check(&read_xlsx(&write_xlsx(&wb).unwrap()).unwrap().0);
+}
