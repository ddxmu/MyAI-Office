+/// Builds a version-3 compound file with one root stream.
+///
+/// Legacy Excel workbooks normally keep the small `Workbook` stream in the mini stream, while
+/// larger workbooks use regular sectors. Keeping this container writer beside the reader makes
+/// the `.xls` export self-contained and avoids depending on an external office suite.
+pub(crate) fn write_stream(name: &str, data: &[u8]) -> Result<Vec<u8>, String> {
+    const FREE: u32 = 0xFFFF_FFFF;
+    const END: u32 = END_OF_CHAIN;
