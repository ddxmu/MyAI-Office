+        return Err("compound stream name is empty or longer than 31 characters".into());
+    }
+    if data.len() > u32::MAX as usize {
+        return Err("compound stream is larger than 4 GB".into());
+    }
+    let mini = data.len() < 4096;
+    let pad = |n: usize, to: usize| n.div_ceil(to) * to;
+    let mut payload: Vec<Vec<u8>> = Vec::new();
+    let mut chains: Vec<(usize, usize)> = Vec::new();
+    let mut dir = Vec::new();
+    let mut minifat = Vec::new();
+    let data_at;
+    let minifat_at;
+    let stream_sectors;
+    if mini {
+        let mini_sectors = data.len().div_ceil(64).max(1);
+        for i in 0..mini_sectors {
+            let next = if i + 1 == mini_sectors { END } else { u32::try_from(i + 1).map_err(|_| "too many mini sectors")? };
+            minifat.extend_from_slice(&next.to_le_bytes());
+        }
+        minifat.resize(512, 0xFF);
+        let mut container = data.to_vec();
+        container.resize(pad(data.len().max(1), 64), 0);
+        stream_sectors = container.len().div_ceil(512);
+        container.resize(stream_sectors * 512, 0);
+        payload.push(Vec::new());
+        payload.push(minifat);
+        payload.extend(container.chunks(512).map(<[u8]>::to_vec));
+        data_at = 2;
+        minifat_at = Some(1usize);
+        chains.push((data_at, stream_sectors));
+        dir.extend_from_slice(&dir_entry(
+            "Root Entry",
+            5,
+            1,
+            0,
+            u32::try_from(stream_sectors * 512).map_err(|_| "compound root stream is too large")?,
+        )?);
+        dir.extend_from_slice(&dir_entry(name, 2, FREE, 0, u32::try_from(data.len()).map_err(|_| "compound stream is too large")?)?);
+    } else {
+        let mut body = data.to_vec();
+        stream_sectors = body.len().div_ceil(512);
+        body.resize(stream_sectors * 512, 0);
+        payload.push(Vec::new());
+        payload.extend(body.chunks(512).map(<[u8]>::to_vec));
+        data_at = 1;
+        minifat_at = None;
+        chains.push((data_at, stream_sectors));
+        dir.extend_from_slice(&dir_entry("Root Entry", 5, 1, END, 0)?);
+        dir.extend_from_slice(&dir_entry(name, 2, FREE, 0, u32::try_from(data.len()).map_err(|_| "compound stream is too large")?)?);
+    }
+    dir.extend_from_slice(&dir_entry("", 0, FREE, FREE, 0)?);
+    dir.extend_from_slice(&dir_entry("", 0, FREE, FREE, 0)?);
+    let mut fat_n = 1usize;
+    while (fat_n + payload.len()).div_ceil(128) > fat_n {
+        fat_n += 1;
+    }
