+#[test]
+fn xls_preserves_chinese_fonts_fills_borders_alignment_and_styled_blanks() {
+    use gridcraft_model::{BorderStyle, Color, HAlign, PatternType, VAlign};
+    let bytes = styled_legacy_workbook(false);
+    // Optional synthetic fixture export for the offscreen UI acceptance check.
+    if let Some(path) = std::env::var_os("GRIDCRAFT_XLS_QA_PATH") {
+        std::fs::write(path, &bytes).unwrap();
+    }
+    let (wb, _) = read_xls(&bytes).unwrap();
+    let check = |wb: &gridcraft_model::Workbook| {
+        let sheet = &wb.sheets[0];
+        let style = |a1: &str| wb.styles.get(sheet.style_id(CellRef::parse(a1).unwrap()));
+        let header = style("B2");
+        assert_eq!(header.font.name, "黑体");
+        assert_eq!(header.font.size, 14.0);
+        assert!(header.font.bold);
+        assert_eq!(header.fill.pattern, PatternType::Solid);
+        assert_eq!(header.fill.fg, Color::Rgb(0xFFAD7E));
+        assert_eq!(header.align.h, HAlign::Center);
+        assert_eq!(header.align.v, VAlign::Center);
+        assert!(header.align.wrap);
+        assert_eq!(header.borders.bottom.style, BorderStyle::Thin);
+        assert_eq!(header.borders.bottom.color, Color::Rgb(0));
+        assert_eq!(style("A2").fill.fg, Color::Rgb(0x007EA8));
+        assert_eq!(style("B14").font.name, "宋体");
+        assert_eq!(style("B14").font.size, 10.5);
+        assert_eq!(style("B14").font.color, Color::Rgb(0xFF0000));
+        assert_eq!(style("B15").borders.left.style, BorderStyle::Thin);
+        assert!(sheet.cell(CellRef::parse("B15").unwrap()).is_some(), "styled empty cells must be stored");
+        assert_eq!(style("A3").align.v, VAlign::Center);
+        assert_eq!(sheet.merges, [RangeRef::parse("A3:A13").unwrap()]);
+        assert_eq!(v(wb, 0, "B3"), Value::from("测试岗位"));
+        assert_eq!(sheet.rows.get(&1).unwrap().size, Some(crate::tables::pt_to_px(38.0)));
+    };
+    check(&wb);
+    let (reopened, _) = read_xlsx(&write_xlsx(&wb).unwrap()).unwrap();
+    check(&reopened);
+}
