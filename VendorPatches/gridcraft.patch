+//! BIFF8 Font, Palette and XF formatting, from [MS-XLS] 2.4.122, 2.4.188 and 2.4.353.
+//! Keep font and palette references until all globals have been read: Palette often follows XF.
+
+use gridcraft_model::{
+    Alignment, BorderLine, BorderStyle, Borders, Color, Fill, Font, HAlign, NumFmt, PatternType, Style, Theme, Underline, VAlign, VertAlign,
+};
+
+use super::records::Cursor;
+use crate::IoError;
+
+pub(super) struct FontRecord {
+    font: Font,
+    color: u16,
+}
+
+impl FontRecord {
+    pub(super) fn read(c: &mut Cursor<'_, '_>) -> Result<Self, IoError> {
+        let height = c.u16()?;
+        let flags = c.u16()?;
+        let color = c.u16()?;
+        let weight = c.u16()?;
+        let escapement = c.u16()?;
+        let underline = c.u8()?;
+        c.skip(3)?; // family, character set, reserved
+        let name = c.short_string()?;
+        let mut font = Font {
+            size: (f32::from(height) / 20.0).clamp(1.0, 409.5),
+            bold: weight >= 700,
+            italic: flags & 2 != 0,
+            strike: flags & 8 != 0,
+            underline: match underline {
+                1 => Underline::Single,
+                2 => Underline::Double,
+                0x21 => Underline::SingleAccounting,
+                0x22 => Underline::DoubleAccounting,
+                _ => Underline::None,
+            },
+            vert: match escapement {
+                1 => VertAlign::Superscript,
+                2 => VertAlign::Subscript,
+                _ => VertAlign::Baseline,
+            },
+            ..Font::default()
+        };
+        if !name.is_empty() {
+            font.name = name;
+        }
+        Ok(Self { font, color })
+    }
+
+    pub(super) fn name(&self) -> &str {
+        &self.font.name
+    }
+
+    pub(super) fn resolve(&self, palette: &[u32]) -> Font {
+        Font { color: color(self.color, palette), ..self.font.clone() }
+    }
+}
+
+pub(super) struct Xf {
+    font: u16,
+    pub(super) format: u16,
+    data: Option<[u8; 16]>,
+}
+
+impl Xf {
+    pub(super) fn read(c: &mut Cursor<'_, '_>) -> Result<Self, IoError> {
+        let font = c.u16()?;
+        let format = c.u16()?;
+        // Keep accepting the short XFs accepted by the old reader; use default properties
+        // for a missing tail, rather than interpreting zero padding as real formatting.
+        let data = if c.remaining() >= 16 {
+            let mut data = [0; 16];
+            for b in &mut data {
+                *b = c.u8()?;
+            }
+            Some(data)
+        } else {
+            None
+        };
+        Ok(Self { font, format, data })
+    }
+
+    pub(super) fn resolve(&self, fonts: &[FontRecord], palette: &[u32], number_format: &str) -> Style {
+        // FontIndex 4 is reserved. Indices above it are one greater than their array index.
+        let index = match self.font {
+            0..=3 => Some(usize::from(self.font)),
+            5.. => Some(usize::from(self.font - 1)),
+            _ => None,
+        };
+        let font = index.and_then(|i| fonts.get(i)).or_else(|| fonts.first()).map(|f| f.resolve(palette)).unwrap_or_default();
+        let mut style = Style { font, num_fmt: NumFmt::new(number_format), ..Style::default() };
+        let Some([p0, p1, align, rotation, indent, _, b0, b1, b2, b3, b4, b5, b6, b7, f0, f1]) = self.data else { return style };
+        let lr = u32::from_le_bytes([b0, b1, b2, b3]);
+        let tb = u32::from_le_bytes([b4, b5, b6, b7]);
+        let fill = u16::from_le_bytes([f0, f1]);
+        let border = |kind: u32, index: u32| {
+            let style = border_style(kind as u8);
+            if style == BorderStyle::None { BorderLine::default() } else { BorderLine { style, color: color(index as u16, palette) } }
+        };
+        let diagonal = border((tb >> 21) & 15, (tb >> 14) & 127);
+        style.borders = Borders {
+            left: border(lr & 15, (lr >> 16) & 127),
+            right: border((lr >> 4) & 15, (lr >> 23) & 127),
+            top: border((lr >> 8) & 15, tb & 127),
+            bottom: border((lr >> 12) & 15, (tb >> 7) & 127),
+            diag_down: if lr & (1 << 30) != 0 { diagonal } else { BorderLine::default() },
+            diag_up: if lr & (1 << 31) != 0 { diagonal } else { BorderLine::default() },
+        };
+        let pattern = pattern((tb >> 26) as u8);
+        if pattern != PatternType::None {
+            style.fill = Fill { pattern, fg: color(fill & 127, palette), bg: color((fill >> 7) & 127, palette) };
+        }
+        style.align = Alignment {
+            h: match align & 7 {
+                1 => HAlign::Left,
+                2 => HAlign::Center,
+                3 => HAlign::Right,
+                4 => HAlign::Fill,
+                5 => HAlign::Justify,
+                6 => HAlign::CenterAcross,
+                7 => HAlign::Distributed,
+                _ => HAlign::General,
+            },
+            v: match (align >> 4) & 7 {
+                0 => VAlign::Top,
+                1 => VAlign::Center,
+                3 => VAlign::Justify,
+                4 => VAlign::Distributed,
+                _ => VAlign::Bottom,
+            },
+            wrap: align & 8 != 0,
+            shrink: indent & 16 != 0,
+            indent: indent & 15,
+            rotation: match rotation {
+                0..=90 => i16::from(rotation),
+                91..=180 => 90 - i16::from(rotation),
+                255 => 255,
+                _ => 0,
+            },
+        };
+        let protection = u16::from_le_bytes([p0, p1]);
+        style.protection.locked = protection & 1 != 0;
+        style.protection.hidden = protection & 2 != 0;
+        style
+    }
+}
+
+/// XFExt colours override the older, lossy palette approximations in XF/Font records.
+pub(super) struct XfExt {
+    pub(super) index: usize,
+    colors: Vec<(u16, [u8; 16])>,
+    indent: Option<u8>,
+}
+
+impl XfExt {
+    pub(super) fn read(c: &mut Cursor<'_, '_>) -> Result<Self, IoError> {
+        c.skip(14)?; // FrtHeader and reserved1
+        let index = usize::from(c.u16()?);
+        c.skip(2)?;
+        let count = c.u16()?;
+        let mut ext = Self { index, colors: Vec::new(), indent: None };
+        for _ in 0..count {
+            let kind = c.u16()?;
+            let size = usize::from(c.u16()?).checked_sub(4).ok_or_else(|| super::invalid("short XFExt property"))?;
+            if size > c.remaining() {
+                return Err(super::invalid("truncated XFExt property"));
+            }
+            if matches!(kind, 4 | 5 | 7..=11 | 13) && size == 16 {
+                let mut bytes = [0; 16];
+                for b in &mut bytes {
+                    *b = c.u8()?;
+                }
+                ext.colors.push((kind, bytes));
+            } else if kind == 15 && size == 2 {
+                ext.indent = Some(c.u16()?.min(250) as u8);
+            } else {
+                c.skip(size)?;
+            }
+        }
+        Ok(ext)
+    }
+
+    pub(super) fn apply(&self, style: &mut Style, palette: &[u32]) {
+        for (kind, bytes) in &self.colors {
+            let Some(color) = full_color(bytes, palette) else { continue };
+            match kind {
+                4 => style.fill.fg = color,
+                5 => style.fill.bg = color,
+                7 => style.borders.top.color = color,
+                8 => style.borders.bottom.color = color,
+                9 => style.borders.left.color = color,
+                10 => style.borders.right.color = color,
+                11 => {
+                    style.borders.diag_up.color = color;
+                    style.borders.diag_down.color = color;
+                }
+                13 => style.font.color = color,
+                _ => {}
+            }
+        }
+        if let Some(indent) = self.indent {
+            style.align.indent = indent;
+        }
+    }
+}
+
+fn full_color(b: &[u8; 16], palette: &[u32]) -> Option<Color> {
+    let [t0, t1, s0, s1, r, g, bl, a, ..] = *b;
+    let kind = u16::from_le_bytes([t0, t1]);
+    let tint = (f32::from(i16::from_le_bytes([s0, s1])) / 32767.0).clamp(-1.0, 1.0);
+    let value = u32::from_le_bytes([r, g, bl, a]);
+    if kind == 3 && value < 12 {
+        // Extended cell colours use background/text slots, not clrScheme XML order.
+        return Some(Color::Theme(value as u8, (tint * 1000.0).round() as i16));
+    }
+    let color = match kind {
+        0 => Color::Auto,
+        1 => color(value.min(u32::from(u16::MAX)) as u16, palette),
+        2 => Color::rgb(r, g, bl),
+        _ => return None,
+    };
+    Some(match color {
+        Color::Rgb(v) if tint != 0.0 => {
+            let [r, g, b] = gridcraft_model::style::apply_tint([(v >> 16) as u8, (v >> 8) as u8, v as u8], f64::from(tint));
+            Color::rgb(r, g, b)
+        }
+        _ => color,
+    })
+}
+
+pub(super) fn theme(c: &mut Cursor<'_, '_>) -> Result<Option<Theme>, IoError> {
+    c.skip(12)?;
+    let version = c.u32()?;
+    if c.remaining() == 0 && version == 124226 {
+        // Default Office 2007 theme, not GridCraft's own default palette.
+        return Ok(Some(Theme {
+            name: "Office".into(),
+            colors: [0xFFFFFF, 0, 0xEEECE1, 0x1F497D, 0x4F81BD, 0xC0504D, 0x9BBB59, 0x8064A2, 0x4BACC6, 0xF79646, 0x0000FF, 0x800080],
+            major_font: "Cambria".into(),
+            minor_font: "Calibri".into(),
+        }));
+    }
+    let bytes = c.rest();
+    let mut pkg = crate::package::Package::open(&bytes)?;
+    for part in ["theme/theme/theme1.xml", "theme/theme1.xml", "theme1.xml"] {
+        if let Some(xml) = pkg.read_limited(part, 1024 * 1024)? {
+            return Ok(Some(crate::theme::read_theme(&crate::xml::parse(&xml)?)));
+        }
+    }
+    Ok(None)
+}
+
+pub(super) fn palette(c: &mut Cursor<'_, '_>, colors: &mut [u32]) -> Result<(), IoError> {
+    let count = usize::from(c.u16()?).min(56).min(c.remaining() / 4);
+    for slot in colors.iter_mut().skip(8).take(count) {
+        let (r, g, b) = (c.u8()?, c.u8()?, c.u8()?);
+        c.u8()?; // reserved
+        *slot = (u32::from(r) << 16) | (u32::from(g) << 8) | u32::from(b);
+    }
+    Ok(())
+}
+
+fn color(index: u16, palette: &[u32]) -> Color {
+    match index {
+        64 => Color::Rgb(0),        // system window text
+        65 => Color::Rgb(0xFFFFFF), // system window background
+        _ => palette.get(usize::from(index)).copied().map(Color::Rgb).unwrap_or(Color::Auto),
+    }
+}
+
+fn border_style(index: u8) -> BorderStyle {
+    match index {
+        1 => BorderStyle::Thin,
+        2 => BorderStyle::Medium,
+        3 => BorderStyle::Dashed,
+        4 => BorderStyle::Dotted,
+        5 => BorderStyle::Thick,
+        6 => BorderStyle::Double,
+        7 => BorderStyle::Hair,
+        8 => BorderStyle::MediumDashed,
+        9 => BorderStyle::DashDot,
+        10 => BorderStyle::MediumDashDot,
+        11 => BorderStyle::DashDotDot,
+        12 => BorderStyle::MediumDashDotDot,
+        13 => BorderStyle::SlantDashDot,
+        _ => BorderStyle::None,
+    }
+}
+
+fn pattern(index: u8) -> PatternType {
+    use PatternType::*;
+    match index {
+        1 => Solid,
+        2 => Gray50,
+        3 => Gray75,
+        4 => Gray25,
+        5 => DarkHorizontal,
+        6 => DarkVertical,
+        7 => DarkDown,
+        8 => DarkUp,
+        9 => DarkGrid,
+        10 => DarkTrellis,
+        11 => LightHorizontal,
+        12 => LightVertical,
+        13 => LightDown,
+        14 => LightUp,
+        15 => LightGrid,
+        16 => LightTrellis,
+        17 => Gray125,
+        18 => Gray0625,
+        _ => None,
+    }
+}
