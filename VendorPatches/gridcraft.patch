+/// Original BIFF8 fixture: Chinese fonts, a custom palette, coloured headers, merged labels,
+/// and blank cells whose borders must survive. No real personnel data is included.
+fn styled_legacy_workbook(extended: bool) -> Vec<u8> {
+    let font = |name: &str, height: u16, weight: u16, color: u16| {
+        let text: Vec<u16> = name.encode_utf16().collect();
+        rec(0x0031, &cat(&[&u16s(&[height, 0, color, weight, 0]), &[0, 0, 134, 0, text.len() as u8, 1], &u16s(&text)]))
+    };
+    let xf = |font: u16, fill: Option<u16>, center: bool| {
+        let mut data = u16s(&[font, 0, 1]);
+        data.extend_from_slice(&[if center { 0x1A } else { 0x20 }, 0, 0, 0xFC]);
+        let sides = 0x1111u32 | (64 << 16) | (64 << 23);
+        let other = 64u32 | (64 << 7) | if fill.is_some() { 1 << 26 } else { 0 };
+        data.extend_from_slice(&sides.to_le_bytes());
+        data.extend_from_slice(&other.to_le_bytes());
+        data.extend_from_slice(&(fill.unwrap_or(64) | (65 << 7)).to_le_bytes());
+        rec(0x00E0, &data)
+    };
+    let label = |row, col, style, text: &str| {
+        let units: Vec<u16> = text.encode_utf16().collect();
+        rec(0x0204, &cat(&[&cell(row, col, style), &(units.len() as u16).to_le_bytes(), &[1], &u16s(&units)]))
+    };
+    let mut palette = 56u16.to_le_bytes().to_vec();
+    for i in 0..56 {
+        palette.extend_from_slice(match i {
+            0 => &[255, 0, 0, 0],
+            1 => &[255, 173, 126, 0],
+            2 => &[0, 126, 168, 0],
+            _ => &[0, 0, 0, 0],
+        });
+    }
+    let extensions = if extended {
+        let color = |kind: u16, tint: i16, value: u32| cat(&[&kind.to_le_bytes(), &tint.to_le_bytes(), &value.to_le_bytes(), &[0; 8]]);
+        let ext = |xf: u16, props: &[(u16, Vec<u8>)]| {
+            let mut data = cat(&[&[0x7D, 8], &[0; 12], &xf.to_le_bytes(), &[0, 0], &(props.len() as u16).to_le_bytes()]);
+            for (kind, value) in props {
+                data.extend(cat(&[&kind.to_le_bytes(), &((value.len() + 4) as u16).to_le_bytes(), value]));
+            }
+            rec(0x087D, &data)
+        };
+        let theme = super::make_zip(&[(
+            "theme/theme/theme1.xml",
+            br#"<a:theme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="Original"><a:themeElements><a:clrScheme name="Original"><a:accent1><a:srgbClr val="5B9BD5"/></a:accent1><a:accent2><a:srgbClr val="ED7D31"/></a:accent2></a:clrScheme></a:themeElements></a:theme>"#,
+        )]);
+        cat(&[
+            &ext(1, &[(4, color(3, 13106, 5)), (8, color(2, 0, 0xFF563412))]),
+            &ext(3, &[(4, color(3, -8191, 4))]),
+            &ext(2, &[(13, color(2, 0, 0xFF0000FF))]),
+            &ext(5, &[(4, color(3, 0, 0))]),
+            &rec(0x0896, &cat(&[&[0x96, 8], &[0; 14], &theme])),
+        ])
+    } else {
+        Vec::new()
+    };
+    let globals = |pos: u32| {
+        cat(&[
+            &bof(0x0005),
+            &font("宋体", 210, 400, 0x7FFF),
+            &font("宋体", 210, 400, 8),
+            &font("unused-2", 220, 400, 0x7FFF),
+            &font("unused-3", 220, 400, 0x7FFF),
+            // FontIndex 4 is reserved; the fifth Font record is referenced as index 5.
+            &font("黑体", 280, 700, 0x7FFF),
+            &rec(0x0092, &palette),
+            &xf(0, None, false),
+            &xf(5, Some(9), true),
+            &xf(1, None, false),
+            &xf(0, Some(10), true),
+            &xf(0, None, true),
+            &xf(0, Some(9), false),
+            &extensions,
+            &rec(0x0085, &cat(&[&pos.to_le_bytes(), &[0, 0, 6, 0], b"Roster"])),
+            &eof(),
+        ])
+    };
+    let mut sheet = cat(&[
+        &bof(0x0010),
+        &label(1, 1, 1, "部门/职位"),
+        &label(1, 2, 1, "姓名"),
+        &rec(0x0201, &cell(1, 0, 3)),
+        &label(2, 0, 4, "企业人员"),
+        &label(2, 1, 0, "测试岗位"),
+        &label(2, 2, 0, "测试人员"),
+        &label(13, 1, 2, "质量专员"),
+        &rec(0x00E5, &u16s(&[1, 2, 12, 0, 0])),
+        &rec(0x00BE, &u16s(&[14, 1, 0, 5, 2])),
+        &rec(0x007D, &u16s(&[1, 1, 60 * 256, 0, 0, 0])),
+        &rec(0x0208, &cat(&[&u16s(&[1, 0, 3, 760, 0, 0]), &0x40u32.to_le_bytes()])),
+    ]);
+    sheet.extend_from_slice(&eof());
+    let offset = globals(0).len() as u32;
+    compound("Workbook", &cat(&[&globals(offset), &sheet]))
+}
