+/// Some legacy `.doc` templates store the visible heading number in the paragraph text while
+/// also retaining the old automatic list properties. WPS does not paint the automatic label a
+/// second time in that case. Keep the counter progression, but suppress only the duplicate label
+/// that is already present in the text.
+fn text_starts_with_label(text: &str, label: &str) -> bool {
+    let text = text.trim_start_matches(wordcraft_doc::para::OBJ).trim_start();
+    let label = label.trim();
+    if label.is_empty() || !text.starts_with(label) {
+        return false;
+    }
+    let rest = &text[label.len()..];
+    !(label.ends_with('.') && rest.as_bytes().first().is_some_and(|b| b.is_ascii_digit()))
+}
