+#[test]
+fn consecutive_header_paragraphs_share_one_bottom_border() {
+    let mut doc = Document::from_text("Body text");
+    let blocks = (0..3)
+        .map(|_| {
+            let mut p = Paragraph::new();
+            p.props.borders = Some(Borders { bottom: Some(Border::single(0.75)), ..Default::default() });
+            wordcraft_doc::para_block(p)
+        })
+        .collect();
+    let id = doc.add_part(wordcraft_doc::PartKind::Header, blocks);
+    doc.last_section.headers.default = Some(id);
+    let layout = lay(&doc);
+    let rules: Vec<_> = layout.pages[0].header.iter().filter(|i| matches!(i, Placed::Rule { .. })).collect();
+    assert_eq!(rules.len(), 1, "matching adjacent paragraph borders form one group");
+}
