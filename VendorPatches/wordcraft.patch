+/// The body paragraphs that make up a multi-paragraph table of contents result. Word keeps the
+/// result together when it would otherwise leave only the first entries at the bottom of a page,
+/// while many DOCX writers store no paragraph-level `keepNext` flags for the generated entries.
+fn toc_keep_next_blocks(doc: &Document) -> HashSet<usize> {
+    let mut blocks = HashSet::new();
+    // Scan only the top-level paragraph objects. `Document::field_ranges` also walks every
+    // object offset and is intentionally general; using it here would rescan large runs of
+    // floating objects just to find the occasional TOC marker.
+    let mut open: Vec<(bool, usize)> = Vec::new();
+    for (block, b) in doc.body.iter().enumerate() {
+        let Some(p) = b.as_para() else { continue };
+        for object in &p.objects {
+            match object {
+                InlineObject::FieldStart { instr, .. } => open.push((fields::field_name(instr) == "TOC", block)),
+                InlineObject::FieldEnd => {
+                    let Some((is_toc, start)) = open.pop() else { continue };
+                    if is_toc && open.is_empty() && start < block {
+                        blocks.extend(start..block);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    blocks
