diff --git a/crates/ui-egui/src/paragraph_layout.rs b/crates/ui-egui/src/paragraph_layout.rs
new file mode 100644
index 0000000..7066ea4
--- /dev/null
+++ b/crates/ui-egui/src/paragraph_layout.rs
@@ -0,0 +1,129 @@
+//! The small table paragraph-layout button shown beside a table selection.
+//!
+//! Word shows this control next to table text rather than putting the two actions in the main
+//! ribbon. The actions still go through the normal command path, so they work for text in one
+//! cell as well as whole-cell, row, column and table selections.
+
+use egui::{Order, Rect, Vec2, pos2, vec2};
+use serde_json::json;
+use wordcraft_engine::cmd::table_mouse::cell_rects;
+use wordcraft_layout::{DocLayout, Placed};
+
+use crate::table_resize::{page_scale, to_screen};
+use crate::{WordApp, widgets};
+
+const BUTTON_W: f32 = 34.0;
+const BUTTON_H: f32 = 22.0;
+const BUTTON_GAP: f32 = 6.0;
+const VIEWPORT_PAD: f32 = 4.0;
+
+/// Whether the table control is appropriate for the current editing state.
+pub(crate) fn visible(app: &WordApp) -> bool {
+    app.ui.show_paragraph_layout_button
+        && app.session.math.is_none()
+        && !app.session.view.read_mode
+        && !app.ui.backstage
+        && app.dialog.is_none()
+        && app.colors.is_none()
+        && !app.canvas.context_menu_open
+        && !app.canvas.drag_selecting()
+        && app.canvas.table_drag.is_none()
+        && (app.session.cell_range().is_some() || app.session.sel.focus.path.cell().is_some())
+}
+
+/// Position the button just outside a table's left edge, keeping it inside the canvas viewport.
+/// This pure geometry is also used by the unit tests; document/page lookup happens in
+/// [`button_for_table`].
+pub(crate) fn anchor_rect(table_left: f32, table_top: f32, viewport: Rect) -> Option<Rect> {
+    if !table_left.is_finite() || !table_top.is_finite() || !viewport.is_finite() || !viewport.is_positive() {
+        return None;
+    }
+    if table_top < viewport.top() - BUTTON_H || table_top > viewport.bottom() {
+        return None;
+    }
+    let x = (table_left - BUTTON_W - BUTTON_GAP)
+        .clamp(viewport.left() + VIEWPORT_PAD, (viewport.right() - BUTTON_W - VIEWPORT_PAD).max(viewport.left() + VIEWPORT_PAD));
+    let y = (table_top - 2.0).clamp(viewport.top() + VIEWPORT_PAD, (viewport.bottom() - BUTTON_H - VIEWPORT_PAD).max(viewport.top() + VIEWPORT_PAD));
+    Some(Rect::from_min_size(pos2(x, y), vec2(BUTTON_W, BUTTON_H)))
+}
+
+/// Find a visible cell belonging to the current cell or cell-range selection and turn its page
+/// coordinates into the screen rectangle used by the floating control.
+fn button_for_table(app: &WordApp, layout: &DocLayout, rects: &[Rect], scale: f32, viewport: Rect) -> Option<Rect> {
+    let candidate = if let Some(range) = app.session.cell_range() {
+        cell_rects(layout, &app.session.doc, range).into_iter().min_by(|(pa, a), (pb, b)| {
+            let ay = rects.get(*pa).map_or(f32::MAX, |p| p.min.y + a.y * scale);
+            let by = rects.get(*pb).map_or(f32::MAX, |p| p.min.y + b.y * scale);
+            ay.total_cmp(&by).then_with(|| a.x.total_cmp(&b.x))
+        })
+    } else {
+        let (table, row, cell) = app.session.sel.focus.path.cell()?;
+        layout.pages.iter().enumerate().find_map(|(page, p)| {
+            p.items.iter().find_map(|item| match item {
+                Placed::Cell { rect, covered: false, table: item_table, row: item_row, cell: item_cell, story }
+                    if *story == app.session.sel.focus.story && *item_table == table && *item_row == row && *item_cell == cell =>
+                {
+                    Some((page, *rect))
+                }
+                _ => None,
+            })
+        })
+    }?;
+    let (page, cell) = candidate;
+    let page_rect = rects.get(page)?;
+    if !page_rect.intersects(viewport) {
+        return None;
+    }
+    let page_scale = page_scale(rects, layout, scale, page)?;
+    let top_left = to_screen(rects, layout, scale, page, cell.x, cell.y)?;
+    // Keep the scale lookup meaningful for very small or malformed pages; to_screen already
+    // applies it, and this guard prevents a button from being placed on a zero-sized cell.
+    (page_scale.is_finite() && cell.w > 0.0 && cell.h > 0.0).then(|| anchor_rect(top_left.x, top_left.y, viewport)).flatten()
+}
+
+/// Draw the button and its two table paragraph actions.
+pub(crate) fn show(app: &mut WordApp, ctx: &egui::Context, layout: &DocLayout, rects: &[Rect], scale: f32, viewport: Rect) {
+    if !visible(app) {
+        return;
+    }
+    let Some(button) = button_for_table(app, layout, rects, scale, viewport) else { return };
+    let area = egui::Area::new(egui::Id::new("wc_paragraph_layout_button")).order(Order::Foreground).interactable(true).fixed_pos(button.min);
+    area.show(ctx, |ui| {
+        ui.set_min_size(Vec2::new(BUTTON_W, BUTTON_H));
+        widgets::menu_button(ui, app, "paragraphLayout", None, "Table Layout", false, "", |ui, app| {
+            ui.set_min_width(200.0);
+            if ui.button(tl!("Clear Paragraph Layout")).clicked() {
+                if let Err(e) = app.run("para.reset", json!({})) {
+                    app.status(e);
+                }
+                app.canvas.want_focus = true;
+                ui.close();
+            }
+            if ui.button(tl!("Hide Paragraph Layout Button")).clicked() {
+                app.ui.show_paragraph_layout_button = false;
+                ui.close();
+            }
+        });
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use egui::Pos2;
+
+    #[test]
+    fn button_stays_inside_the_viewport() {
+        let viewport = Rect::from_min_size(Pos2::new(10.0, 20.0), Vec2::new(300.0, 200.0));
+        let button = anchor_rect(16.0, 24.0, viewport).expect("valid anchor");
+        assert!(viewport.contains(button.min));
+        assert!(viewport.contains(button.max - vec2(0.1, 0.1)));
+    }
+
+    #[test]
+    fn invalid_or_offscreen_anchor_is_hidden() {
+        let viewport = Rect::from_min_size(Pos2::ZERO, Vec2::new(300.0, 200.0));
+        assert!(anchor_rect(f32::NAN, 20.0, viewport).is_none());
+        assert!(anchor_rect(100.0, 250.0, viewport).is_none());
+    }
+}
