+/// Writes a real Word 97–2003 compound document on macOS using Apple's system converter.
+/// WordCraft's legacy reader remains clean-room; this is only a bridge from the model's DOCX
+/// writer to the system's OLE/Word binary container, and deliberately does not use LibreOffice.
+#[cfg(target_os = "macos")]
+fn write_legacy_doc(doc: &Document) -> Result<Vec<u8>, String> {
+    use std::io::Write as _;
+    use std::process::{Command, Stdio};
+
+    let package = wordcraft_docx::write(doc).map_err(|e| e.to_string())?;
+    let mut converter = Command::new("/usr/bin/textutil")
+        .args(["-convert", "doc", "-stdout", "-stdin"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|e| format!("couldn't start Apple's Word converter: {e}"))?;
+    let mut input = converter.stdin.take().ok_or_else(|| "Apple's Word converter did not accept input".to_string())?;
+    input.write_all(&package).map_err(|e| format!("couldn't send the temporary DOCX to Apple's Word converter: {e}"))?;
+    drop(input);
+    let output = converter.wait_with_output().map_err(|e| format!("couldn't read Apple's Word converter result: {e}"))?;
+    if !output.status.success() {
+        let detail = String::from_utf8_lossy(&output.stderr).trim().to_string();
+        return Err(if detail.is_empty() { "Apple's Word converter failed".into() } else { format!("Apple's Word converter failed: {detail}") });
+    }
+    Ok(output.stdout)
+}
+
+#[cfg(not(target_os = "macos"))]
+fn write_legacy_doc(_doc: &Document) -> Result<Vec<u8>, String> {
+    Err("saving Word 97–2003 .doc/.dot requires the macOS system Word converter; save as .docx on this platform".into())
+}
