+/// Paragraphs on a legacy cover whose unset line spacing is interpreted as single spacing by
+/// Word/WPS. The modern editor default remains 1.5 lines; this is limited to a first section that
+/// visibly contains a cover image and a metadata table, so ordinary documents keep their own
+/// default behavior.
+fn compatibility_cover_blocks(doc: &Document) -> HashSet<usize> {
+    let mut blocks = HashSet::new();
+    if doc.settings.compat_mode < 15 {
+        return blocks;
+    }
+    let Some((end, _)) = doc.sections().first().copied() else { return blocks };
+    let cover = doc.body.iter().take(end.saturating_add(1));
