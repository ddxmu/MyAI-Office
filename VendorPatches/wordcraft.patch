+/// Turn tabular plain text into a small table fragment when the caret is in a table. This is the
+/// text-only equivalent of copying cells from another application such as Excel.
+pub(crate) fn table_fragment_from_text(s: &Session, text: &str) -> Option<Fragment> {
+    if !s.sel.focus.path.cell().is_some() || !text.contains('\t') {
+        return None;
+    }
+    let normalized = text.replace("\r\n", "\n").replace('\r', "\n");
+    let mut lines: Vec<&str> = normalized.split('\n').collect();
+    // Excel and Word commonly terminate a tabular clipboard payload with one line break; it is
+    // a separator, not an extra blank record.
+    if lines.len() > 1 && lines.last() == Some(&"") {
+        lines.pop();
+    }
+    if lines.is_empty() {
+        return None;
+    }
+    let cols = lines.iter().map(|line| line.split('\t').count()).max().unwrap_or(1).clamp(1, 63);
+    let width = s.sel.focus.path.cell().and_then(|(table, _, _)| s.doc.table(s.sel.focus.story, &table)).map(Table::total_width).unwrap_or(468.0);
+    let mut table = Table::new(lines.len(), cols, width);
+    for (row, line) in lines.iter().enumerate() {
+        for (col, value) in line.split('\t').take(cols).enumerate() {
+            if let Some(cell) = table.rows.get_mut(row).and_then(|r| r.cells.get_mut(col)) {
+                *cell = Cell::with_text(value);
+            }
+        }
+    }
+    Some(Fragment { blocks: vec![Block::Table(table)], ..Default::default() })
+}
+
+/// Paste plain text with the table-cell distribution used by Paste Text Only. Text without tabular
+/// separators keeps the ordinary paragraph paste path.
+pub(crate) fn paste_text(s: &mut Session, text: &str) -> Result<(), CmdError> {
+    if let Some(frag) = table_fragment_from_text(s, text) {
+        insert(s, frag)
+    } else {
+        super::paste_text(s, &text.replace("\r\n", "\r").replace('\n', "\r"))
+    }
+}
