+                // Processing a pointer replaces the remaining Prls in its containing list.
+                if next.is_some() {
+                    break;
+                }
+            } else {
+                result.extend_from_slice(&p.op.to_le_bytes());
+                result.extend_from_slice(p.operand);
+            }
+        }
+        let Some(next) = next else { break };
+        current = next;
+    }
