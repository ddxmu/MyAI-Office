+/// Chinese and other East Asian documents commonly use spaces for indentation and visual
+/// separation around full-width punctuation. Those spaces are formatting, not English grammar
+/// errors, even when the run has no explicit proofing language.
+fn is_english_extra_space(text: &str, start: usize) -> bool {
+    let Some(before) = text.get(..start).and_then(|prefix| prefix.chars().next_back()) else { return false };
+    let Some(after) = text.get(start + 2..).and_then(|suffix| suffix.chars().next()) else { return false };
+    !before.is_whitespace() && !after.is_whitespace() && !is_cjk_or_fullwidth(before) && !is_cjk_or_fullwidth(after)
+}
+
+fn is_cjk_or_fullwidth(c: char) -> bool {
+    matches!(
+        c,
+        '\u{1100}'..='\u{11ff}'
+            | '\u{2e80}'..='\u{2fff}'
+            | '\u{3000}'..='\u{303f}'
+            | '\u{3040}'..='\u{30ff}'
+            | '\u{3100}'..='\u{312f}'
+            | '\u{3130}'..='\u{318f}'
+            | '\u{31a0}'..='\u{31bf}'
+            | '\u{3400}'..='\u{4dbf}'
+            | '\u{4e00}'..='\u{9fff}'
+            | '\u{a960}'..='\u{a97f}'
+            | '\u{ac00}'..='\u{d7ff}'
+            | '\u{f900}'..='\u{faff}'
+            | '\u{fe30}'..='\u{fe4f}'
+            | '\u{ff00}'..='\u{ffef}'
+            | '\u{20000}'..='\u{2ffff}'
+    )
+}
