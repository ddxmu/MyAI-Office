+/// Keep the paragraph dialog's tab captions in English for existing automation and add the WPS
+/// mnemonic suffixes in the Chinese UI.
+fn paragraph_tab_label(name: &str, mnemonic: &str) -> String {
+    let label = tl!(name);
+    if crate::i18n::current().code().starts_with("zh") {
+        format!("{label}({mnemonic})")
+    } else {
+        label.to_string()
+    }
+}
+
+/// Return the WPS-style preset key for the current line-spacing rule/value.
+fn paragraph_line_choice(rule: &str, line: f32) -> String {
+    if rule == "atLeast" || rule == "exactly" {
+        return rule.to_string();
+    }
+    if (line - 1.0).abs() < 0.01 {
+        "single".to_string()
+    } else if (line - 1.5).abs() < 0.01 {
+        "oneAndHalf".to_string()
+    } else if (line - 2.0).abs() < 0.01 {
+        "double".to_string()
+    } else {
+        "multiple".to_string()
+    }
+}
+
+fn paragraph_line_label(choice: &str) -> String {
+    match choice {
+        "single" => tl!("Single Spacing").to_string(),
+        "oneAndHalf" => tl!("1.5 Line Spacing").to_string(),
+        "double" if crate::i18n::current().code().starts_with("zh") => "2 倍行距".to_string(),
+        "double" => tl!("Double Spacing").to_string(),
+        "atLeast" => tl!("At least").to_string(),
+        "exactly" => tl!("Exactly").to_string(),
+        "multiple" if crate::i18n::current().code().starts_with("zh") => "多倍行距".to_string(),
+        _ => "Multiple".to_string(),
+    }
+}
+
+fn paragraph_special_label() -> String {
+    if crate::i18n::current().code().starts_with("zh") {
+        format!("特殊格式{}", char::from_u32(0xFF1A).unwrap_or(':'))
+    } else {
+        "Special format:".to_string()
+    }
+}
+
+fn paragraph_preview_sample() -> String {
+    if crate::i18n::current().code().starts_with("zh") {
+        let comma = char::from_u32(0x3001).unwrap_or(',');
+        let period = char::from_u32(0x3002).unwrap_or('.');
+        format!("这是一段用于预览缩进{comma}间距{comma}分页效果的示例文字{period}")
+    } else {
+        "This sample previews paragraph indentation, spacing and page-break behavior.".to_string()
+    }
+}
