+/// Stshif.ftcFE supplies the East Asian font when no style or run overrides it.
+pub(crate) fn default_east_asian_font(table: &[u8], fc: u32, lcb: u32, fonts: &[String]) -> Option<String> {
+    let data = table.get(fc as usize..(fc as usize).checked_add(lcb as usize)?)?;
+    let cb = data.get(..2).map(|b| u16::from_le_bytes([b[0], b[1]]))?;
