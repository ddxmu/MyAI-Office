+            if p.op == 0x646B || (p.op == 0x6646 && i == 0) {
+                let [a, b, c, d] = p.operand else { continue };
+                let at = u32::from_le_bytes([*a, *b, *c, *d]) as usize;
+                if seen.contains(&at) {
