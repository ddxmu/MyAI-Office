+/// A numbered heading in legacy Chinese templates often has no Heading 1 style at all. Keep the
+/// test narrow: a numeric or Chinese-numeral prefix must be followed by a heading separator and
+/// visible text. This avoids treating ordinary body paragraphs that merely start with a number as
+/// page headings.
+fn looks_like_numbered_heading(text: &str) -> bool {
+    let text = text.trim();
+    let mut chars = text.chars().peekable();
+    let mut prefix = 0;
+    while chars
+        .peek()
+        .is_some_and(|c| c.is_ascii_digit() || matches!(c, '一' | '二' | '三' | '四' | '五' | '六' | '七' | '八' | '九' | '十' | '百' | '千'))
+    {
+        chars.next();
+        prefix += 1;
+    }
+    if prefix == 0 {
+        return false;
+    }
+    let mut separator = false;
+    while let Some(c) = chars.peek().copied() {
+        if !matches!(c, '.' | '．' | '、' | ' ') && !c.is_ascii_whitespace() {
+            break;
+        }
+        separator |= c == '.' || c == '．' || c == '、' || c.is_ascii_whitespace();
+        chars.next();
+    }
+    separator && chars.any(|c| !c.is_whitespace())
+}
