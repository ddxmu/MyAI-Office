+#[test]
+fn table_separate_row_marks_and_external_papx_preserve_header() {
+    let text = "A\u{7}B\u{7}\u{7}C\u{7}D\u{7}\u{7}tail\r";
+    let in_table = grpprl(&[(0x2416, &[1]), (0x6649, &1u32.to_le_bytes())]);
+    let mut def = t_def_table(&[0, 1440, 4320]);
+    let tc_at = 5 + 3 * 2;
+    for i in 0..2 {
+        let at = tc_at + 20 * i;
+        def[at..at + 2].copy_from_slice(&0x0680u16.to_le_bytes()); // twips and vertically centered
+        def[at + 4..at + 8].copy_from_slice(&[4, 1, 1, 0]); // top cell border
+    }
+    let row = [in_table.clone(), grpprl(&[(0x2417, &[1])]), def, grpprl(&[(0xD62F, &[11, 0, 2, 4, 0, 0, 0, 0xFF, 8, 1, 0, 0])])].concat();
+    // A real TTP is a separate mark after the last cell, and a long row's PAPX can live
+    // in the Data stream. Use original synthetic content, never a private user's file.
+    let shading = [vec![20], [[0, 0, 0, 0xFF, 217, 234, 247, 0, 0, 0]; 2].concat()].concat();
+    let external = [row.clone(), grpprl(&[(0x9407, &800u16.to_le_bytes()), (0xD612, &shading)])].concat();
+    let data = [vec![0; 4], (external.len() as u16).to_le_bytes().to_vec(), external].concat();
+    let spec = StructSpec {
+        text,
+        header_stories: vec![],
+        sections: vec![(text.chars().count() as u32, Vec::new())],
+        chpx_runs: vec![(0, Vec::new())],
+        papx_entries: vec![
+            (0, 0, in_table.clone()),
+            (2, 0, in_table.clone()),
+            (4, 0, grpprl(&[(0x6646, &4u32.to_le_bytes())])),
+            (5, 0, in_table.clone()),
+            (7, 0, in_table),
+            (9, 0, row),
+            (10, 0, Vec::new()),
+        ],
+        plf_lst: Vec::new(),
+        plf_lfo: Vec::new(),
+        note_stories: vec![],
+        endnote_stories: vec![],
+        extra_pairs: Vec::new(),
+        data_stream: data,
+    };
+    let doc = read(&struct_doc(&spec)).expect("opens");
+    let table = doc.body.iter().find_map(|b| b.as_table()).expect("table");
+    assert_eq!(table.rows.len(), 2);
+    assert!(table.rows.iter().all(|r| r.cells.len() == 2), "a TTP must not add an empty cell or join two rows");
+    assert_eq!(table.grid, [72.0, 144.0]);
+    assert!(table.props.fixed);
+    assert_eq!(table.rows[0].cells[0].props.valign, wordcraft_doc::props::VAlign::Center);
+    assert_eq!(table.rows[0].cells[0].props.borders.unwrap().top.unwrap().width, 0.5);
+    assert_eq!(table.rows[0].cells[0].props.borders.unwrap().bottom.unwrap().width, 1.0);
+    assert_eq!(table.rows[0].props.height, Some(40.0));
+    assert_eq!(table.rows[0].cells[0].props.shading, Some(wordcraft_doc::Rgb(217, 234, 247)));
+    assert_eq!(table.rows[0].cells[1].props.shading, Some(wordcraft_doc::Rgb(217, 234, 247)));
+    assert_eq!(table.rows[1].cells[0].props.shading, None);
+    let cell_text =
+        |r: usize, c: usize| table.rows[r].cells[c].blocks.iter().filter_map(|b| b.as_para()).map(|p| p.text.as_str()).collect::<String>();
+    assert_eq!(cell_text(0, 1), "B");
+    assert_eq!(cell_text(1, 0), "C");
+}
