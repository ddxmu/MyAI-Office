+/// Keep welcome-page labels inside the recent-document row while retaining the useful tail of a
+/// long path/name. This prevents the painter text from crossing the page's content boundary.
+fn ellipsize(ui: &Ui, text: &str, max_width: f32, font: egui::FontId, color: egui::Color32) -> String {
+    if max_width <= 0.0 {
+        return String::new();
+    }
+    let fits = |value: &str| ui.ctx().fonts_mut(|fonts| fonts.layout_no_wrap(value.to_owned(), font.clone(), color).size().x <= max_width);
+    if fits(text) {
+        return text.to_owned();
+    }
+    let mut result = String::new();
+    for ch in text.chars() {
+        let candidate = format!("{result}{ch}…");
+        if !fits(&candidate) {
+            break;
+        }
+        result.push(ch);
+    }
+    format!("{result}…")
+}
