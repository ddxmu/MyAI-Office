+    /// Copy a rectangular selection of whole table cells as a table fragment.
+    ///
+    /// A normal range copy deliberately flattens a range that crosses paragraph containers. That
+    /// is right for text selections, but it loses the row/column shape of a Word table selection.
+    /// Keeping the selected cells in a small table lets the engine paste them into corresponding
+    /// destination cells instead of concatenating them into the cell at the caret.
+    pub fn copy_table_cells(&self, story: StoryRef, table: &Path, rows: (usize, usize), cols: (usize, usize)) -> Option<Fragment> {
+        let source = self.table(story, table)?;
+        let last_row = source.rows.len().checked_sub(1)?;
+        let last_col = source.cols().checked_sub(1)?;
+        let r0 = rows.0.min(rows.1).min(last_row);
+        let r1 = rows.0.max(rows.1).min(last_row);
+        let g0 = cols.0.min(cols.1).min(last_col);
+        let g1 = cols.0.max(cols.1).min(last_col);
+        let grid: Vec<f32> = (g0..=g1).map(|g| source.grid.get(g).copied().unwrap_or(72.0)).collect();
+        let width = grid.iter().sum();
+        let mut copied = Table { props: source.props.clone(), grid, rows: Vec::with_capacity(r1 - r0 + 1), controls: source.controls.clone() };
+        copied.props.width = Some(width);
+        copied.props.width_pct = None;
+        for r in r0..=r1 {
+            let Some(source_row) = source.rows.get(r) else { continue };
+            let mut row = Row { props: source_row.props.clone(), cells: Vec::new(), controls: source_row.controls.clone() };
+            let mut start = 0usize;
+            for source_cell in &source_row.cells {
+                let end = start.saturating_add(source_cell.span());
+                let from = start.max(g0);
+                let to = end.min(g1.saturating_add(1));
+                if from < to {
+                    let mut cell: Cell = source_cell.clone();
+                    cell.props.span = (to - from) as u32;
+                    cell.props.width = copied.grid.get(from - g0..to - g0).map(|v| v.iter().sum());
+                    row.cells.push(cell);
+                }
+                start = end;
+            }
+            if row.cells.is_empty() {
+                row.cells.push(Cell::empty());
+            }
+            copied.rows.push(row);
+        }
+        let mut blocks = vec![Block::Table(copied)];
+        crate::control::balance_blocks(&mut blocks);
+        let parts = self.text_box_parts(&blocks);
+        Some(Fragment { blocks, parts })
+    }
