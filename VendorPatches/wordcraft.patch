+/// Huge paragraph properties and table properties point at length-prefixed PrcData in
+/// the Data stream. Follow their chain with checked bounds and a strict depth limit.
+pub(crate) fn expand_papx<'a>(papx: &'a [u8], data: &'a [u8]) -> std::borrow::Cow<'a, [u8]> {
+    if !iter(papx).any(|p| matches!(p.op, 0x6646 | 0x646B)) {
+        return std::borrow::Cow::Borrowed(papx);
+    }
+    let mut current = papx;
+    let mut seen = Vec::new();
+    let mut result = Vec::new();
+    for _ in 0..16 {
+        let mut next = None;
+        for (i, p) in iter(current).enumerate() {
+            if p.op == 0x646B || (p.op == 0x6646 && i == 0) {
+                let [a, b, c, d] = p.operand else { continue };
+                let at = u32::from_le_bytes([*a, *b, *c, *d]) as usize;
+                if seen.contains(&at) {
+                    break;
+                }
+                seen.push(at);
+                if let Some(head) = data.get(at..at.saturating_add(2)) {
+                    let len = usize::from(u16::from_le_bytes([head[0], head[1]]));
+                    next = data.get(at.saturating_add(2)..at.saturating_add(2).saturating_add(len));
+                }
+                // Processing a pointer replaces the remaining Prls in its containing list.
+                if next.is_some() {
+                    break;
+                }
+            } else {
+                result.extend_from_slice(&p.op.to_le_bytes());
+                result.extend_from_slice(p.operand);
+            }
+        }
+        let Some(next) = next else { break };
+        current = next;
+    }
+    std::borrow::Cow::Owned(result)
+}
