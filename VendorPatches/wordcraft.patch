+    assert_eq!(super::stsh::default_east_asian_font(&style_header, 0, 20, &fonts), Some("宋体".into()));
+    let mut chars = wordcraft_doc::props::CharProps::default();
+    let ops = grpprl(&[(0x4A50, &1u16.to_le_bytes())]);
+    for p in super::sprm::iter(&ops) {
+        super::fmt::apply_char(&mut chars, &p, &Default::default(), &fonts);
+    }
+    assert_eq!(chars.font_ea.as_deref(), Some("宋体"));
+    let mut para = wordcraft_doc::props::ParaProps::default();
+    let ops = grpprl(&[(0x6426, &[6, 1, 1, 1]), (0xC650, &[8, 10, 20, 30, 0, 8, 1, 2, 0])]);
+    for p in super::sprm::iter(&ops) {
+        super::fmt::apply_para(&mut para, &p);
+    }
+    let b = para.borders.unwrap().bottom.unwrap();
+    assert_eq!(b.width, 1.0);
+    assert_eq!(b.color, Some(wordcraft_doc::Rgb(10, 20, 30)));
+}
