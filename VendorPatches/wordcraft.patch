+fn is_toc_instruction(instr: &str) -> bool {
+    instr.split_whitespace().next().is_some_and(|name| name.eq_ignore_ascii_case("TOC"))
+}
+
+/// Word 97-2003 files commonly cache a TOC as nested HYPERLINK/PAGEREF fields. The legacy
+/// walker intentionally flattens nested fields, so normalize that cached result back into
+/// readable TOC lines instead of exposing the field instructions as document text.
+fn toc_cached_text(result: &str) -> Option<String> {
+    if !result.contains("HYPERLINK") || !result.contains("PAGEREF") {
+        return None;
+    }
+    let mut rest = result;
+    let mut lines = Vec::new();
+    while let Some(start) = rest.find("HYPERLINK") {
+        rest = &rest[start..];
+        let end = rest.find(" HYPERLINK").unwrap_or(rest.len());
+        let entry = &rest[..end];
+        let Some((left, right)) = entry.split_once('\t') else {
+            if end == rest.len() {
+                break;
+            }
+            rest = &rest[end + 1..];
+            continue;
+        };
+        let mut parts = left.trim().splitn(4, |c: char| c.is_whitespace());
+        let Some(name) = parts.next() else { break };
+        let Some(switch) = parts.next() else { break };
+        let Some(_bookmark) = parts.next() else { break };
+        let Some(title) = parts.next().map(str::trim).filter(|title| !title.is_empty()) else { break };
+        let Some(page) = right.split_whitespace().last().filter(|page| !page.is_empty()) else { break };
+        if name.eq_ignore_ascii_case("HYPERLINK") && switch == "\\l" {
+            lines.push(format!("{title}\t{page}"));
+        }
+        if end == rest.len() {
+            break;
+        }
+        rest = &rest[end + 1..];
+    }
+    (!lines.is_empty()).then(|| lines.join("\n"))
+}
