+/// Paint a WPS-like border preview in a menu item. The light dotted grid keeps the target
+/// recognizable when no border is active; the selected sides are then drawn over it in the
+/// same compact, high-contrast style as the reference menu.
+fn border_menu_item(ui: &mut Ui, app: &mut WordApp, label: &str, id: &str, params: Value, mask: u8) {
+    let text = tl!(label);
+    let enabled = crate::widgets::enabled(app, id);
+    let width = ui.available_width().clamp(260.0, 320.0);
+    let (rect, resp) = ui.allocate_exact_size(vec2(width, 30.0), Sense::click());
+    let t = Tokens::get(ui.ctx());
+    if resp.hovered() || resp.is_pointer_button_down_on() {
+        ui.painter().rect_filled(rect, CornerRadius::same(4), t.hover);
+    }
+
+    let preview = Rect::from_min_size(pos2(rect.min.x + 12.0, rect.center().y - 11.0), vec2(28.0, 22.0));
+    paint_border_preview(ui, preview, mask, enabled, &t);
+    let ink = if enabled { t.text } else { t.text_dim.gamma_multiply(0.55) };
+    ui.painter().text(pos2(preview.max.x + 12.0, rect.center().y), Align2::LEFT_CENTER, text, regular(12.5), ink);
+    let shortcut = crate::widgets::shortcut_text(app, id);
+    if !shortcut.is_empty() {
+        ui.painter().text(pos2(rect.max.x - 10.0, rect.center().y), Align2::RIGHT_CENTER, shortcut, regular(11.0), t.text_dim);
+    }
+    if enabled && resp.clicked() {
+        crate::widgets::run_from_ribbon(app, id, params);
+        ui.close();
+    }
+}
+
+fn paint_border_preview(ui: &Ui, rect: Rect, mask: u8, enabled: bool, t: &Tokens) {
+    let p = ui.painter();
+    let inner = rect.shrink(2.0);
+    let grid = if enabled { t.border.gamma_multiply(0.72) } else { t.border.gamma_multiply(0.45) };
+    let active = if enabled { t.text } else { t.text_dim };
+    let dotted = Stroke::new(0.8, grid);
+    dotted_h(p, inner.left(), inner.right(), inner.top(), dotted);
+    dotted_h(p, inner.left(), inner.right(), inner.center().y, dotted);
+    dotted_h(p, inner.left(), inner.right(), inner.bottom(), dotted);
+    dotted_v(p, inner.top(), inner.bottom(), inner.left(), dotted);
+    dotted_v(p, inner.top(), inner.bottom(), inner.center().x, dotted);
+    dotted_v(p, inner.top(), inner.bottom(), inner.right(), dotted);
+
+    let line = Stroke::new(1.6, active);
+    if mask & 0b000001 != 0 {
+        p.line_segment([pos2(inner.left(), inner.top()), pos2(inner.right(), inner.top())], line);
+    }
+    if mask & 0b000010 != 0 {
+        p.line_segment([pos2(inner.left(), inner.bottom()), pos2(inner.right(), inner.bottom())], line);
+    }
+    if mask & 0b000100 != 0 {
+        p.line_segment([pos2(inner.left(), inner.top()), pos2(inner.left(), inner.bottom())], line);
+    }
+    if mask & 0b001000 != 0 {
+        p.line_segment([pos2(inner.right(), inner.top()), pos2(inner.right(), inner.bottom())], line);
+    }
+    if mask & 0b010000 != 0 {
+        p.line_segment([pos2(inner.left(), inner.center().y), pos2(inner.right(), inner.center().y)], line);
+    }
+    if mask & 0b100000 != 0 {
+        p.line_segment([pos2(inner.center().x, inner.top()), pos2(inner.center().x, inner.bottom())], line);
+    }
+}
+
+fn dotted_h(p: &egui::Painter, x0: f32, x1: f32, y: f32, stroke: Stroke) {
+    let mut x = x0;
+    while x < x1 {
+        p.line_segment([pos2(x, y), pos2((x + 1.5).min(x1), y)], stroke);
+        x += 3.5;
+    }
+}
+
+fn dotted_v(p: &egui::Painter, y0: f32, y1: f32, x: f32, stroke: Stroke) {
+    let mut y = y0;
+    while y < y1 {
+        p.line_segment([pos2(x, y), pos2(x, (y + 1.5).min(y1))], stroke);
+        y += 3.5;
+    }
+}
