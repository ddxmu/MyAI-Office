+/// Union row boundaries, then express each cell's original physical extent as a grid span.
+/// This also works when a table starts with a single full-width title cell.
+fn shared_grid(rows: &mut [(Row, Vec<f32>)], fallback: &[f32]) -> Vec<f32> {
+    const EPS: f32 = 0.05;
+    let mut edges = vec![0.0];
+    for (_, widths) in rows.iter() {
+        let mut x = 0.0;
+        for width in widths {
+            x += width;
+            edges.push(x);
+        }
+    }
+    edges.sort_by(f32::total_cmp);
+    edges.dedup_by(|a, b| (*a - *b).abs() < EPS);
+    if edges.len() < 2 || edges.len() > MAX_COLS + 1 {
+        return fallback.to_vec();
+    }
+    for (row, widths) in rows {
+        let widths = if widths.is_empty() { fallback } else { widths.as_slice() };
+        let mut column = 0usize;
+        let mut x = 0.0;
+        for cell in &mut row.cells {
+            let end = column.saturating_add(cell.span()).min(widths.len());
+            let right = x + widths.get(column..end).unwrap_or(&[]).iter().sum::<f32>();
+            let left_edge = edges.iter().position(|edge| (*edge - x).abs() < EPS);
+            let right_edge = edges.iter().position(|edge| (*edge - right).abs() < EPS);
