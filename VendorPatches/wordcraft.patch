+pub(crate) fn paste_text(s: &mut Session, text: &str) -> Result<(), CmdError> {
+    if let Some(frag) = table_fragment_from_text(s, text) {
+        insert(s, frag)
+    } else {
+        super::paste_text(s, &text.replace("\r\n", "\r").replace('\n', "\r"))
+    }
+}
