+                seen.push(at);
+                if let Some(head) = data.get(at..at.saturating_add(2)) {
+                    let len = usize::from(u16::from_le_bytes([head[0], head[1]]));
+                    next = data.get(at.saturating_add(2)..at.saturating_add(2).saturating_add(len));
