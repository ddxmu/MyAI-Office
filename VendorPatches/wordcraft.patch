+#[test]
+fn chinese_font_alias_is_used_for_the_east_asian_run() {
+    let asian = wordcraft_fonts::word::resolve("宋体", false, false);
+    if !asian.face.covers('中') || !asian.face.covers('文') {
+        return;
+    }
+    let mut doc = Document::from_text("ABC中文");
+    doc.format_range(&Pos::body(0, 0), &Pos::body(0, "ABC中文".len()), &|c| {
+        c.font = Some("Arial".into());
+        c.font_ea = Some("宋体".into());
+    })
+    .unwrap();
+    let layout = lay(&doc);
+    let para = layout.pages[0].items.iter().find_map(|i| if let Placed::Lines { para, .. } = i { Some(para) } else { None }).unwrap();
+    for cluster in para.clusters.iter().filter(|c| c.start >= 3) {
+        assert_eq!(para.styles[cluster.style as usize].face.id(), asian.face.id());
+    }
+}
