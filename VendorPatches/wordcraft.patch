+/// Empty cover separators between the metadata table, revision table and their heading.
+///
+/// Legacy DOC files often carry a full blank paragraph with before/after spacing in this one
+/// location. WPS treats it as a visual separator but still keeps the short revision table on the
+/// cover; collapsing only this table-to-table spacer prevents its last blank row from spilling.
+fn compatibility_cover_spacers(doc: &Document) -> HashSet<usize> {
+    let mut spacers = HashSet::new();
+    for (block, current) in doc.body.iter().enumerate() {
+        let Some(p) = current.as_para() else { continue };
+        if !p.text.is_empty() || p.props.space_before.is_none() || p.props.space_after.is_none() {
+            continue;
+        }
+        let between_tables = block > 0
+            && doc.body.get(block - 1).and_then(|b| b.as_table()).is_some()
+            && doc.body.get(block + 1).and_then(|b| b.as_para()).is_some_and(|next| !next.text.is_empty())
+            && doc.body.get(block + 2).and_then(|b| b.as_table()).is_some();
