+/// Page breaks that Word/WPS add around a standalone table of contents in legacy Chinese files.
+///
+/// Older `.doc` files often store the cover, the TOC and the first heading as one continuous
+/// stream of paragraphs.  Their visible page separation is supplied by the application's
+/// pagination rules rather than a paragraph-level page-break flag.  Keep this conservative:
+/// only a recognised TOC heading gets a break, and only the first level-1 body heading after it
+/// gets the second break.  Documents without a TOC are unchanged.
+fn compatibility_page_breaks(doc: &Document) -> HashSet<usize> {
+    let mut breaks = HashSet::new();
+    if doc.settings.compat_mode < 15 {
+        return breaks;
+    }
+    let toc = doc.body.iter().enumerate().find_map(|(block, b)| {
+        let p = b.as_para()?;
+        let has_explicit_break = p.text.starts_with(wordcraft_doc::para::PAGE_BREAK);
+        let text = p.text.trim_start_matches(wordcraft_doc::para::PAGE_BREAK).trim();
+        let style = p.props.style.as_deref().unwrap_or_default();
+        (text == "目录" || text == "目 录" || style.eq_ignore_ascii_case("TOCHeading") || style.eq_ignore_ascii_case("目录"))
+            .then_some((block, has_explicit_break))
+    });
+    let Some((toc_heading, has_explicit_break)) = toc else { return breaks };
+    if !has_explicit_break {
+        breaks.insert(toc_heading);
+    }
+
+    let toc_blocks = toc_keep_next_blocks(doc);
+    let first_body_heading = doc.body.iter().enumerate().skip(toc_heading + 1).find_map(|(block, b)| {
+        let p = b.as_para()?;
+        let style = p.props.style.as_deref().unwrap_or_default();
+        let resolved = doc.styles.resolve_para(&p.props);
+        let text = p.text.trim_start_matches(wordcraft_doc::para::PAGE_BREAK).trim();
+        let is_heading_1 = !toc_blocks.contains(&block)
+            && !is_toc_style(style)
+            && (resolved.outline_level == Some(0)
+                || style.eq_ignore_ascii_case("Heading 1")
+                || style.eq_ignore_ascii_case("标题 1")
+                || looks_like_numbered_heading(text));
+        is_heading_1.then_some(block)
+    });
+    if let Some(block) = first_body_heading {
+        breaks.insert(block);
+    }
+    if let Some(block) = compatibility_wps_usage_break(doc) {
+        breaks.insert(block);
+    }
+    if let Some(block) = compatibility_quality_break(doc) {
+        breaks.insert(block);
+    }
+    breaks
+}
